<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>at.hl7.testing</groupId>
        <artifactId>testrunner-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>testrunner-app</artifactId>
    <name>TestRunner :: Application</name>
    <description>The executable jar: Spring Boot command line application that runs the configured TestScripts.
        Also hosts the end-to-end integration tests (*IT) and the architecture rules.</description>

    <dependencies>
        <!-- core and fhir-hapi also come through the modules below; they are named because the app uses core directly
             and because the coverage report (report-aggregate) only looks at direct dependencies -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-fhir-hapi</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-fhir-r4</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-fhir-r5</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-validation-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-test-support</artifactId>
            <type>test-jar</type>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- HapiServerIT: a real HAPI FHIR server in Docker (version from the Spring Boot BOM) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- the resources of the parent POM again, a build of its own does not inherit them: the license of the
             project goes into the jar, the notices of the libraries are written to target/classes/META-INF -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
            <resource>
                <directory>src/license/licenses</directory>
                <targetPath>META-INF/licenses</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- THIRD-PARTY-NOTICES.txt: the libraries the executable jar ships, with licenses and where their
                     source is, for the jar and the container images (MPL 2.0 asks for it for Saxon-HE) -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>third-party-notices</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <thirdPartyFilename>THIRD-PARTY-NOTICES.txt</thirdPartyFilename>
                            <fileTemplate>${project.basedir}/src/license/third-party-notices.ftl</fileTemplate>
                            <includedScopes>compile,runtime</includedScopes>
                            <excludedGroups>^at\.hl7\.testing</excludedGroups>
                            <!-- a library without license information fails the build instead of going unnoticed -->
                            <failOnMissing>true</failOnMissing>
                            <!-- the same license under the names the libraries' POMs give it -->
                            <licenseMerges>
                                <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache Software License 2.0|Apache License version 2.0|Apache 2.0|Apache 2</licenseMerge>
                                <licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
                                <licenseMerge>BSD-3-Clause|BSD 3 Clause</licenseMerge>
                                <licenseMerge>EPL-2.0|EPL 2.0</licenseMerge>
                                <licenseMerge>GPL-2.0-with-classpath-exception|GPL2 w/ CPE</licenseMerge>
                                <licenseMerge>MPL-2.0|Mozilla Public License Version 2.0</licenseMerge>
                            </licenseMerges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>at.hl7.testing.runner.app.TestRunnerApplication</mainClass>
                    <!-- testrunner-app-<version>-exec.jar is the executable jar; the plain jar stays the main
                         artifact, so it can be used as a library and failsafe tests the plain classes -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <plugin>
                <!-- the software bill of materials of the executable jar: every library it ships, with versions and
                     licenses, target/bom.json and target/bom.xml -->
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                        <configuration>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- one coverage report of every module, from all their unit and integration tests:
                     target/site/jacoco-aggregate/index.html -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
