<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>at.hl7.testing</groupId>
        <artifactId>testrunner-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>testrunner-test-support</artifactId>
    <name>TestRunner :: Test support</name>
    <description>Test doubles shared by the unit and integration tests: an in-memory FHIR server, a fake
        validator CLI and access to the sample TestScripts. Test code only (src/test/java), published as test-jar
        (classifier tests). Deliberately independent of testrunner-core so that every module, including core, can
        use it.</description>

    <dependencies>
        <!-- Compile scope on purpose: the test-jar's users get these transitively (in their test scope);
             test-scoped dependencies would not be passed on. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- HTTP server of InMemoryFhirServer and of the fake validator's server mode -->
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the main jar stays empty (manifest only); Maven requires it as the module's main file -->
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
