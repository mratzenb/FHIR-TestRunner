{
  "resourceType": "TestScript",
  "id": "copy-patient-between-servers",
  "url": "http://hl7.at/fhir/test/TestScript/copy-patient-between-servers",
  "name": "CopyPatientBetweenServers",
  "title": "Copy a patient from one server to another",
  "status": "draft",
  "description": "Reads a patient that is created on both servers (autocreate), then sends the patient read from server 1 to server 2 and checks that server 2 returns what server 1 has. Needs testrunner.suites[n].fhir-servers 1 and 2.",
  "origin": [
    {
      "index": 1,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types",
        "code": "FHIR-Client"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types",
        "code": "FHIR-Server"
      }
    },
    {
      "index": 2,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types",
        "code": "FHIR-Server"
      }
    }
  ],
  "fixture": [
    {
      "id": "patient",
      "autocreate": true,
      "autodelete": true,
      "resource": {
        "reference": "Patient/several-servers"
      }
    }
  ],
  "test": [
    {
      "name": "ReadOnBoth",
      "description": "The autocreated patient is on each server, under the id that server gave it.",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "read"
            },
            "resource": "Patient",
            "accept": "json",
            "encodeRequestUrl": true,
            "origin": 1,
            "destination": 1,
            "targetId": "patient",
            "responseId": "on-server-1"
          }
        },
        {
          "assert": {
            "description": "Server 1 has it.",
            "responseCode": "200",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "read"
            },
            "resource": "Patient",
            "accept": "json",
            "encodeRequestUrl": true,
            "origin": 1,
            "destination": 2,
            "targetId": "patient"
          }
        },
        {
          "assert": {
            "description": "Server 2 has it.",
            "responseCode": "200",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "name": "CopyFromOneToTwo",
      "description": "What server 1 returned is created on server 2 and read back from there.",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "resource": "Patient",
            "accept": "json",
            "contentType": "json",
            "encodeRequestUrl": true,
            "origin": 1,
            "destination": 2,
            "sourceId": "on-server-1",
            "responseId": "copied"
          }
        },
        {
          "assert": {
            "description": "Server 2 created the copy.",
            "responseCode": "201",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "read"
            },
            "resource": "Patient",
            "accept": "json",
            "encodeRequestUrl": true,
            "origin": 1,
            "destination": 2,
            "targetId": "copied"
          }
        },
        {
          "assert": {
            "description": "The copy on server 2 has the name of the patient on server 1.",
            "expression": "Patient.name.family",
            "operator": "equals",
            "compareToSourceId": "on-server-1",
            "compareToSourceExpression": "Patient.name.family",
            "warningOnly": false
          }
        },
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "delete"
            },
            "resource": "Patient",
            "encodeRequestUrl": true,
            "origin": 1,
            "destination": 2,
            "targetId": "copied"
          }
        }
      ]
    }
  ]
}
