<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>at.hl7.testing</groupId>
        <artifactId>testrunner-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>testrunner-spring-boot-autoconfigure</artifactId>
    <name>TestRunner :: Spring Boot auto-configuration</name>
    <description>Pre-defined Spring configuration: binds the externalized "testrunner.*" properties to the
        RunConfiguration and wires the engine. Every bean backs off when an application defines its own.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <!-- Used when present: profile validation with the HL7 Validator CLI -->
            <groupId>${project.groupId}</groupId>
            <artifactId>testrunner-validation-cli</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- Only used when Logback is the logging backend (per-run log files) -->
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
